DB_PATH=/app/data/agi_hardware_trends.db
HEALTHCHECK_FILE=/app/data/heartbeat.txt

# Pure Aggregator Mode: bypasses per-batch LLM filtering in app.py and writes all
# deduplicated multi-vertical items + engagement snapshots directly to SQLite WAL
# so tech-trend-researcher has complete longitudinal time-series history.
PURE_AGGREGATOR_MODE=true
FETCH_MINUTES=5

# Core fetchers from app.py
ENABLE_ARXIV=true
ARXIV_RESULTS_PER_CATEGORY=25
ARXIV_CATEGORIES=cs.AR,cs.DC,cs.ET,cs.RO,cs.LG,quant-ph,physics.optics,physics.app-ph,eess.SP,eess.SY

ENABLE_HACKERNEWS=true
HN_NEW_STORIES_PER_RUN=80
HN_FETCH_WORKERS=8
ARXIV_FETCH_WORKERS=4

ENABLE_TECHMEME=true
ENABLE_SPECIALIST_RSS=true
SPECIALIST_RSS_FEEDS=Semiconductor Engineering=https://semiengineering.com/feed/|The Register HPC=https://www.theregister.com/on_prem/headlines.atom|ServeTheHome=https://www.servethehome.com/feed/|OCP Blog=https://www.opencompute.org/blog/rss;;https://news.google.com/rss/search?q=%22Open+Compute+Project%22&hl=en-US&gl=US&ceid=US:en

ENABLE_SUPPLY_CHAIN_RSS=true
SUPPLY_CHAIN_RSS_MAX_ITEMS_PER_FEED=15
SUPPLY_CHAIN_RSS_FEEDS=DIGITIMES Asia=https://www.digitimes.com/rss/daily.xml|TrendForce Semiconductors=https://www.trendforce.com/feed/Semiconductors.html

ENABLE_HTML_SCRAPER=true
HTML_SCRAPER_MAX_ITEMS_PER_SITE=12
HTML_SCRAPER_TARGETS=TrendForce News=https://www.trendforce.com/news/;;/\d{4}/\d{2}/\d{2}/

ENABLE_SEC_EDGAR=true
SEC_USER_AGENT=AI-Hardware-Trend-Bot/2.3 contact@example.com
SEC_FORMS=8-K,10-Q,10-K,S-1,F-1,20-F,6-K

# Expanded Multi-Vertical Ingestion (Biomedical, Robotics, Quantum, Venture/Financing, Reddit, GitHub)
ENABLE_MULTI_VERTICAL_FEEDS=true
MULTI_VERTICAL_RSS_FEEDS=bioRxiv Bioinformatics=https://connect.biorxiv.org/biorxiv_xml.php?subject=bioinformatics|FierceBiotech=https://www.fiercebiotech.com/rss/xml|Nature Biotechnology=https://www.nature.com/nbt.rss|IEEE Spectrum Robotics=https://spectrum.ieee.org/feeds/topic/robotics.rss|The Robot Report=https://www.therobotreport.com/feed/|Quantum Computing Report=https://quantumcomputingreport.com/feed/|Physics World Quantum=https://physicsworld.com/c/quantum/feed/|TechCrunch Venture=https://techcrunch.com/category/venture/feed/|Crunchbase News=https://news.crunchbase.com/feed/

ENABLE_REDDIT_INGESTION=true
REDDIT_SUBREDDITS=semiconductors,hardware,LocalLLaMA,biotech,robotics,QuantumComputing
REDDIT_LIMIT_PER_SUB=15

ENABLE_GITHUB_INGESTION=true
GITHUB_SEARCH_TOPICS=cuda,rocm,riscv,verilog,fpga,quantum,robotics,openfold

# Legacy LLM / Telegram fields (only used when PURE_AGGREGATOR_MODE=false)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SEND_RAW_FETCH_REPORT=false
SEND_RAW_FETCH_JSON=false
