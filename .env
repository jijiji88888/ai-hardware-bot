# =========================
# Required keys
# =========================
OPENROUTER_API_KEY=your_openrouter_api_key_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
SEND_RAW_FETCH_REPORT=false
SEND_RAW_FETCH_JSON=false

# =========================
# Model
# =========================
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
DEBUG_LLM=false

# =========================
# Storage
# =========================
DB_PATH=/app/data/agi_hardware_trends.db

# Liveness file touched at the end of every successful fetch cycle. Point a
# Docker HEALTHCHECK at this file's mtime to detect a stuck container
# without tailing logs (e.g. `find /app/data/heartbeat.txt -mmin -15`).
HEALTHCHECK_FILE=/app/data/heartbeat.txt

# =========================
# Logging
# =========================
# DEBUG / INFO / WARNING / ERROR. Replaces the old scattered print() calls.
LOG_LEVEL=INFO

# =========================
# Runtime cadence
# =========================
# Fetching and flushing now run as two INDEPENDENT scheduled jobs instead of
# one synchronous job, so a slow/backed-up LLM flush can no longer delay the
# next fetch. FETCH_MINUTES controls fetch_and_enqueue(); QUEUE_FLUSH_LIMIT /
# CHECK_QUEUE_SECONDS / FORCE_FLUSH_MINUTES now actually drive maybe_flush(),
# instead of being print-only settings.
FETCH_MINUTES=2
CHECK_QUEUE_SECONDS=1
FORCE_FLUSH_MINUTES=30
DIGEST_MINUTES=60
SEND_STARTUP_MESSAGE=true
SEND_EMPTY_DIGEST=false
INCLUDE_ALERTS_IN_DIGEST=false

# How many times a failed batch is requeued before it's dead-lettered
# (marked failed_permanent in processed_urls and dropped) instead of
# cycling through classify_batch forever on a bad key or safety-filtered
# content.
MAX_ITEM_RETRIES=5

# =========================
# Fetch resilience
# =========================
# After this many consecutive failures, a given feed URL is put on cooldown
# and the live fetch attempt is skipped (going straight to Wayback) for
# FEED_COOLDOWN_MINUTES, instead of hammering a feed that's been blocked for
# a while every single cycle.
FEED_FAILURE_THRESHOLD=4
FEED_COOLDOWN_MINUTES=60

# Bounded concurrency for fetchers that make many small independent
# requests (HN item bodies, arXiv categories) instead of fetching serially.
HN_FETCH_WORKERS=8
ARXIV_FETCH_WORKERS=4

# Defensive character cap applied to Gemini's free-text fields
# (why_it_matters, ai_revolution_thesis, telegram_summary, etc.) before they
# reach SQLite/Telegram, independent of the "one or two sentences"
# instruction in the prompt.
LLM_TEXT_FIELD_MAX_CHARS=500

# =========================
# Caps / token pressure control
# =========================
MAX_CANDIDATES_PER_RUN=1000
MAX_CANDIDATES_PER_FLUSH=96
CANDIDATE_QUEUE_MAX=480
QUEUE_FLUSH_LIMIT=1
LLM_BATCH_SIZE=12
LLM_MIN_SCORE=7.0
ALERT_THRESHOLD=7.5
MAX_ALERTS_PER_FLUSH=8
DIGEST_MAX_ITEMS=5

# =========================
# Existing sources
# =========================
ENABLE_ARXIV=true
ARXIV_RESULTS_PER_CATEGORY=20
# Stronger AI-hardware arXiv defaults (including optics, applied physics, materials science, fluid dynamics, and networking for the 6 frontier pillars). Override only if needed.
ARXIV_CATEGORIES=cs.AR,cs.DC,cs.ET,cs.NI,cs.RO,cs.LG,eess.SP,eess.SY,eess.IV,physics.optics,physics.app-ph,cond-mat.mtrl-sci,physics.flu-dyn

# Targeted arXiv keyword searches for the 6 Priority Frontier Hardware Pillars (Format: PillarLabel=ArXivQuery|PillarLabel2=ArXivQuery2)
ENABLE_ARXIV_FRONTIER_SEARCH=true
ARXIV_FRONTIER_MAX_RESULTS_PER_TOPIC=8
ARXIV_FRONTIER_QUERIES='Advanced Thermal Management & Liquid/Immersion Cooling Systems=("microchannel" OR "cold plate" OR "immersion cooling" OR "dielectric fluid" OR "coolant distribution" OR "microfluidic cooling" OR "two-phase cooling") AND (cat:physics.flu-dyn OR cat:physics.app-ph OR cat:cs.AR OR cat:cs.DC OR cat:eess.SY)|Glass Substrates & Panel-Level Packaging (PLP)=("glass substrate" OR "through-glass via" OR "TGV" OR "panel-level packaging" OR "FOPLP" OR "glass interposer" OR "ABF substrate") AND (cat:cond-mat.mtrl-sci OR cat:physics.app-ph OR cat:cs.AR OR cat:cs.ET)|Next-Generation Memory Hierarchies & Near-Memory Compute=("HBM4" OR "HBM4e" OR "Compute Express Link" OR "CXL 3" OR "memory pooling" OR "processing-in-memory" OR "near-memory compute" OR "near-memory computing") AND (cat:cs.AR OR cat:cs.DC OR cat:cs.ET OR cat:eess.SY)|Rack-Scale High-Voltage Power Delivery & Point-of-Load (PoL) Conversion=("vertical power delivery" OR "integrated voltage regulator" OR "point-of-load" OR "400V" OR "800V" OR "backside power delivery" OR "GaN converter") AND (cat:eess.SY OR cat:physics.app-ph OR cat:cs.AR OR cat:cs.ET)|Ultra-Wide Bandgap Materials & Synthetic Diamond Thermal Spreaders=("CVD diamond" OR "diamond heat spreader" OR "diamond substrate" OR "gallium oxide" OR "Ga2O3" OR "aluminum nitride" OR "ultra-wide bandgap") AND (cat:cond-mat.mtrl-sci OR cat:physics.app-ph)|All-Optical Circuit Switching (OCS) & Co-Packaged Switch Fabrics=("optical circuit switch" OR "MEMS mirror" OR "co-packaged optics" OR "51.2T" OR "102.4T" OR "optical switch fabric" OR "silicon photonic switch") AND (cat:physics.optics OR cat:physics.app-ph OR cat:cs.NI OR cat:cs.AR OR cat:cs.DC)'

ENABLE_HACKERNEWS=true
HN_NEW_STORIES_PER_RUN=80

ENABLE_TECHMEME=true
TECHMEME_MAX_ITEMS=40


# =========================
# Step 1: specialist media, 6 selected sources including OCP, Data Center Dynamics & Chips and Cheese
# =========================
ENABLE_SPECIALIST_RSS=true
SPECIALIST_RSS_MAX_ITEMS_PER_FEED=12
# Format uses | between feeds and NAME=URL for each feed. A URL can itself
# contain ';;'-separated fallback URLs, tried in order until one returns
# items. OCP now chains its direct blog RSS first, falling back to the
# Google News search proxy only if the direct feed is unreachable, instead
# of using the proxy alone (which under-covers vs. OCP's own posts).
SPECIALIST_RSS_FEEDS=Semiconductor Engineering=https://semiengineering.com/feed/|The Register HPC=https://www.theregister.com/on_prem/headlines.atom|ServeTheHome=https://www.servethehome.com/feed/|OCP Blog=https://news.google.com/rss/search?q=%22Open+Compute+Project%22&hl=en-US&gl=US&ceid=US:en;;https://www.opencompute.org/blog/rss|Data Center Dynamics=https://www.datacenterdynamics.com/en/rss/|Chips and Cheese=https://chipsandcheese.com/feed/

# =========================
# Step 1b: targeted Frontier Hardware Pillar RSS feeds (6 physical scaling bottlenecks)
# =========================
ENABLE_FRONTIER_TOPIC_RSS=true
FRONTIER_TOPIC_RSS_MAX_ITEMS_PER_FEED=8
FRONTIER_TOPIC_RSS_FEEDS=Frontier / Thermal & Immersion Cooling=https://news.google.com/rss/search?q=(%22direct-to-chip%22+OR+%22microchannel+cold+plate%22+OR+%22immersion+cooling%22+OR+%22coolant+distribution+unit%22+OR+%22microfluidic+cooling%22+OR+%22dielectric+fluid%22)+AND+(AI+OR+datacenter+OR+GPU+OR+semiconductor)&hl=en-US&gl=US&ceid=US:en|Frontier / Glass Substrates & FOPLP=https://news.google.com/rss/search?q=(%22glass+substrate%22+OR+%22through-glass+via%22+OR+%22TGV%22+OR+%22FOPLP%22+OR+%22panel-level+packaging%22+OR+%22glass+interposer%22+OR+%22ABF+substrate%22)&hl=en-US&gl=US&ceid=US:en|Frontier / HBM4, CXL 3 & Near-Memory Compute=https://news.google.com/rss/search?q=(%22HBM4%22+OR+%22HBM4e%22+OR+%22CXL+3.0%22+OR+%22CXL+3.1%22+OR+%22memory+pooling%22+OR+%22processing-in-memory%22+OR+%22near-memory+compute%22)&hl=en-US&gl=US&ceid=US:en|Frontier / Rack HV Power, VPD & GaN/SiC PoL=https://news.google.com/rss/search?q=(%22400V+DC%22+OR+%22800V+DC%22+OR+%22vertical+power+delivery%22+OR+%22integrated+voltage+regulator%22+OR+%22point-of-load%22)+AND+(datacenter+OR+rack+OR+GaN+OR+SiC+OR+AI)&hl=en-US&gl=US&ceid=US:en|Frontier / UWBG & CVD Diamond Thermal=https://news.google.com/rss/search?q=(%22CVD+diamond%22+OR+%22diamond+heat+spreader%22+OR+%22diamond+substrate%22+OR+%22gallium+oxide%22+OR+%22Ga2O3%22+OR+%22ultra-wide+bandgap%22)+AND+(semiconductor+OR+wafer+OR+thermal+OR+power)&hl=en-US&gl=US&ceid=US:en|Frontier / All-Optical Switching & CPO=https://news.google.com/rss/search?q=(%22optical+circuit+switch%22+OR+%22co-packaged+optics%22+OR+%2251.2T%22+OR+%22102.4T%22+OR+%22MEMS+mirror%22+OR+%22optical+engine%22)+AND+(switch+OR+ASIC+OR+AI+OR+cluster)&hl=en-US&gl=US&ceid=US:en

# =========================
# Step 2: Asia / supply-chain sources
# =========================
ENABLE_SUPPLY_CHAIN_RSS=true
SUPPLY_CHAIN_RSS_MAX_ITEMS_PER_FEED=12
SUPPLY_CHAIN_RSS_FEEDS=DIGITIMES Asia=https://www.digitimes.com/rss/daily.xml|TrendForce Semiconductors=https://www.trendforce.com/feed/Semiconductors.html

# =========================
# Universal HTML Scraper
# =========================
# Format: Label=PageURL[;;OptionalURLPattern]|Label2=PageURL2...
# If ;;pattern is omitted, it auto-detects article links on the domain.
ENABLE_HTML_SCRAPER=true
HTML_SCRAPER_MAX_ITEMS_PER_SITE=12

# Example with TrendForce and future sites:
HTML_SCRAPER_TARGETS=TrendForce News=https://www.trendforce.com/news/;;/\d{4}/\d{2}/\d{2}/

# =========================
# Step 3: SEC EDGAR — market-wide full-text search (EFTS)
# =========================
ENABLE_SEC_EDGAR=true
# SEC asks for a descriptive user agent with contact info. Replace with your email/domain.
SEC_USER_AGENT=AI-Hardware-Trend-Bot/2.3 your_email@example.com
SEC_FORMS=8-K,10-Q,10-K,S-1,F-1,20-F,6-K
SEC_LOOKBACK_DAYS=3
SEC_MAX_ITEMS_PER_FETCH=40
SEC_EFTS_QUERY='"HBM" OR "HBM4" OR "HBM4e" OR "high bandwidth memory" OR "CoWoS" OR "glass substrate" OR "through-glass via" OR "FOPLP" OR "panel-level packaging" OR "Compute Express Link" OR "processing-in-memory" OR "near-memory" OR "silicon photonics" OR "co-packaged optics" OR "optical circuit switch" OR "liquid cooling" OR "immersion cooling" OR "cold plate" OR "coolant distribution unit" OR "microfluidic cooling" OR "vertical power delivery" OR "integrated voltage regulator" OR "CVD diamond" OR "gallium oxide" OR "AI accelerator" OR "GPU cluster" OR "wafer-scale" OR "advanced packaging" OR "optical interconnect"'

# Topic-scoped SEC EFTS queries across the 6 Priority Frontier Hardware Pillars (Format: PillarLabel=EFTSQuery|PillarLabel2=EFTSQuery2)
ENABLE_SEC_FRONTIER_EXPANSION=true
FRONTIER_SEC_EFTS_QUERIES='Advanced Thermal Management & Liquid/Immersion Cooling Systems="direct-to-chip" OR "cold plate" OR "microchannel" OR "immersion cooling" OR "dielectric fluid" OR "coolant distribution unit" OR "microfluidic cooling"|Glass Substrates & Panel-Level Packaging (PLP)="glass substrate" OR "through-glass via" OR "panel-level packaging" OR "FOPLP" OR "glass interposer" OR "ABF substrate"|Next-Generation Memory Hierarchies & Near-Memory Compute="HBM4" OR "HBM4e" OR "Compute Express Link" OR "CXL 3.0" OR "CXL 3.1" OR "memory pooling" OR "processing-in-memory" OR "near-memory compute"|Rack-Scale High-Voltage Power Delivery & Point-of-Load (PoL) Conversion="400V DC" OR "800V DC" OR "rack busbar" OR "vertical power delivery" OR "integrated voltage regulator" OR "point-of-load"|Ultra-Wide Bandgap Materials & Synthetic Diamond Thermal Spreaders="CVD diamond" OR "diamond substrate" OR "diamond heat spreader" OR "gallium oxide" OR "Ga2O3" OR "aluminum nitride" OR "ultra-wide bandgap"|All-Optical Circuit Switching (OCS) & Co-Packaged Switch Fabrics="optical circuit switch" OR "MEMS mirror" OR "co-packaged optics" OR "51.2T" OR "102.4T" OR "optical engine"'

