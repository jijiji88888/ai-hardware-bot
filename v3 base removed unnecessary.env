# =========================
# Required keys
# =========================
OPENROUTER_API_KEY=your_openrouter_api_key_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
SEND_RAW_FETCH_REPORT=false
SEND_RAW_FETCH_JSON=false

# =========================
# Model
# =========================
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
DEBUG_LLM=false

# =========================
# Storage
# =========================
DB_PATH=/app/data/agi_hardware_trends.db

# Liveness file touched at the end of every successful fetch cycle. Point a
# Docker HEALTHCHECK at this file's mtime to detect a stuck container
# without tailing logs (e.g. `find /app/data/heartbeat.txt -mmin -15`).
HEALTHCHECK_FILE=/app/data/heartbeat.txt

# =========================
# Logging
# =========================
# DEBUG / INFO / WARNING / ERROR. Replaces the old scattered print() calls.
LOG_LEVEL=INFO

# =========================
# Runtime cadence
# =========================
# Fetching and flushing now run as two INDEPENDENT scheduled jobs instead of
# one synchronous job, so a slow/backed-up LLM flush can no longer delay the
# next fetch. FETCH_MINUTES controls fetch_and_enqueue(); QUEUE_FLUSH_LIMIT /
# CHECK_QUEUE_SECONDS / FORCE_FLUSH_MINUTES now actually drive maybe_flush(),
# instead of being print-only settings.
FETCH_MINUTES=2
CHECK_QUEUE_SECONDS=1
FORCE_FLUSH_MINUTES=30
DIGEST_MINUTES=60
SEND_STARTUP_MESSAGE=true
SEND_EMPTY_DIGEST=false
INCLUDE_ALERTS_IN_DIGEST=false

# How many times a failed batch is requeued before it's dead-lettered
# (marked failed_permanent in processed_urls and dropped) instead of
# cycling through classify_batch forever on a bad key or safety-filtered
# content.
MAX_ITEM_RETRIES=5

# =========================
# Fetch resilience
# =========================
# After this many consecutive failures, a given feed URL is put on cooldown
# and the live fetch attempt is skipped (going straight to Wayback) for
# FEED_COOLDOWN_MINUTES, instead of hammering a feed that's been blocked for
# a while every single cycle.
FEED_FAILURE_THRESHOLD=4
FEED_COOLDOWN_MINUTES=180

# Bounded concurrency for fetchers that make many small independent
# requests (HN item bodies, arXiv categories) instead of fetching serially.
HN_FETCH_WORKERS=8
ARXIV_FETCH_WORKERS=4

# Defensive character cap applied to Gemini's free-text fields
# (why_it_matters, ai_revolution_thesis, telegram_summary, etc.) before they
# reach SQLite/Telegram, independent of the "one or two sentences"
# instruction in the prompt.
LLM_TEXT_FIELD_MAX_CHARS=500

# =========================
# Caps / token pressure control
# =========================
MAX_CANDIDATES_PER_RUN=1000
MAX_CANDIDATES_PER_FLUSH=96
CANDIDATE_QUEUE_MAX=480
QUEUE_FLUSH_LIMIT=1
LLM_BATCH_SIZE=12
LLM_MIN_SCORE=7.0
ALERT_THRESHOLD=7.5
MAX_ALERTS_PER_FLUSH=8
DIGEST_MAX_ITEMS=5

# =========================
# Existing sources
# =========================
ENABLE_ARXIV=true
ARXIV_RESULTS_PER_CATEGORY=20
# Stronger AI-hardware arXiv defaults. Override only if needed.
ARXIV_CATEGORIES=cs.AR,cs.DC,cs.ET,cs.RO,cs.LG,eess.SP,eess.SY,eess.IV,physics.optics

ENABLE_HACKERNEWS=true
HN_NEW_STORIES_PER_RUN=80

ENABLE_TECHMEME=true
TECHMEME_MAX_ITEMS=40


# =========================
# Step 1: specialist media, 4 selected sources including OCP
# =========================
ENABLE_SPECIALIST_RSS=true
SPECIALIST_RSS_MAX_ITEMS_PER_FEED=12
# Format uses | between feeds and NAME=URL for each feed. A URL can itself
# contain ';;'-separated fallback URLs, tried in order until one returns
# items. OCP now chains its direct blog RSS first, falling back to the
# Google News search proxy only if the direct feed is unreachable, instead
# of using the proxy alone (which under-covers vs. OCP's own posts).
SPECIALIST_RSS_FEEDS=Semiconductor Engineering=https://semiengineering.com/feed/|The Register HPC=https://api.theregister.com/api/v1/article?limit=25&orderBy=published&query=tag%3Ahpc&remapper=rss&site_id=2|ServeTheHome=https://www.servethehome.com/feed/|OCP Blog=https://news.google.com/rss/search?q=%22Open+Compute+Project%22&hl=en-US&gl=US&ceid=US:en;;https://www.opencompute.org/blog/rss

# =========================
# Step 2: Asia / supply-chain sources
# =========================
ENABLE_SUPPLY_CHAIN_RSS=true
SUPPLY_CHAIN_RSS_MAX_ITEMS_PER_FEED=12
SUPPLY_CHAIN_RSS_FEEDS=DIGITIMES Asia=https://www.digitimes.com/rss/daily.xml|TrendForce Semiconductors=https://www.trendforce.com/feed/Semiconductors.html

# =========================
# Step 3: SEC EDGAR — broad feed + targeted watchlist
# =========================
ENABLE_SEC_EDGAR=true
# SEC asks for a descriptive user agent with contact info. Replace with your email/domain.
SEC_USER_AGENT=AI-Hardware-Trend-Bot/2.3 your_email@example.com
SEC_FORMS=8-K,10-Q,10-K,S-1,F-1,20-F,6-K

# Size of the broad "getcurrent" feed (serendipitous discovery across every
# filer). This name is what the code actually reads; previously it wasn't
# set here at all and silently used the code default.
SEC_MAX_ITEMS_PER_FETCH=100



# =========================
# Step 4: OpenReview only
# =========================
ENABLE_OPENREVIEW=false
OPENREVIEW_API_BASE=https://api2.openreview.net
OPENREVIEW_MAX_NOTES_PER_INVITATION=12
OPENREVIEW_INVITATIONS=ICLR.cc/2026/Conference/-/Submission,NeurIPS.cc/2025/Conference/-/Submission,ICML.cc/2026/Conference/-/Submission


